# Copy to .env and adjust. Every value here has a working default in docker-compose.yml.

# ---- Database
POSTGRES_DB=fleetdesk
POSTGRES_USER=fleetdesk
POSTGRES_PASSWORD=change-me-before-production

# ---- Ports on the host
WEB_PORT=8080            # the app
API_PORT=8081            # API on 127.0.0.1 only, for curl and the smoke test
MAIL_UI_PORT=8025        # Mailpit, to read the emails the app sends

# ---- Behaviour
TZ=Asia/Dhaka
FLEETDESK_MODE=api       # api = use the backend; mock = browser-only demo data
SEED_DEMO_DATA=true      # load the sample fleet into an empty database on first start

# ---- Sign-in
AUTH_MODE=password       # password = Fleet Desk's own login page; proxy = trust an SSO proxy
SESSION_HOURS=12         # idle timeout for a signed-in session
SHOW_DEMO_ACCOUNTS=true  # the login page lists the sample accounts — turn off for real use
DEMO_PASSWORD=FleetDesk-2026
# ADMIN_EMAIL=you@company.local   # creates your own team lead account on first start
# ADMIN_PASSWORD=                 # leave blank for a one-time password printed to the log

# ---- Mail
SMTP_HOST=mail           # your relay's hostname in production
SMTP_PORT=1025           # 25 or 587 for a real relay
MAIL_RETRY_SECONDS=300
